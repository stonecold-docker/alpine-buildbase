#!/bin/sh

set -e

echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> Installing required packages"
PKG_LIB="alpine-sdk linux-headers patch diffutils autoconf automake libtool cmake bash grep gawk wget python2 python2-dev python3 python3-dev"
PKG_DEV=""
docker-install -r -u ${PKG_LIB} ${PKG_DEV}
echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> OK"
echo

echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> Installing pip"
wget --no-check-certificate -q -O - https://bootstrap.pypa.io/get-pip.py | python2
wget --no-check-certificate -q -O - https://bootstrap.pypa.io/get-pip.py | python3
pip3 install virtualenv -i http://ftp.daumkakao.com/pypi/simple --trusted-host ftp.daumkakao.com
for pip in py2-pip py2-setuptools py2-wheel py3-pip py3-setuptools py3-wheel py3-filelock py3-six py3-distlib py3-appdirs py3-virtualenv
do
	apk add --virtual ${pip}
done
echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> OK"
echo

echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> Uninstalling unnecessary packages"
docker-install -d -c ${PKG_DEV}
echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> OK"
echo

