#!/bin/sh

set -e

echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> Installing required packages"
PKG_LIB="alpine-sdk linux-headers patch diffutils autoconf automake libtool cmake remake-make bash grep gawk wget python2 python2-dev python3 python3-dev"
PKG_DEV=""
docker-install -r -u ${PKG_LIB} ${PKG_DEV}
echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> OK"
echo

echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> Installing musl for hub.docker.comd"
LD_FULL_PATH=
case "$(uname -m)" in
	x86_64)
		ALPINE_ARCH=x86_64
		;;
	aarch64)
		ALPINE_ARCH=aarch64
		;;
	armv7l)
		ALPINE_ARCH=armv7
		;;
esac
mkdir -p /build/musl
cd /build/musl
wget --no-check-certificate -q -O - https://mirror.xtom.com.hk/alpine/v3.13/main/${ALPINE_ARCH}/musl-1.2.2-r1.apk | tar zxf -
wget --no-check-certificate -q -O - https://mirror.xtom.com.hk/alpine/v3.13/main/${ALPINE_ARCH}/libacl-2.2.53-r0.apk | tar zxf -

mkdir -p /lib/musl
mv lib/* /lib/musl/
cat << EOF > /etc/profile.d/muslbuild.sh
export LD_LIBRARY_PATH="/lib/musl:/lib:/usr/lib"
EOF
cd /
rm -rf /build
echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> OK"
echo

echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> Installing pip"
wget --no-check-certificate -q -O - https://bootstrap.pypa.io/pip/2.7/get-pip.py | python2
wget --no-check-certificate -q -O - https://bootstrap.pypa.io/get-pip.py | python3
pip3 install --no-cache-dir virtualenv
for pip in py2-pip py2-setuptools py2-wheel py3-pip py3-setuptools py3-wheel py3-filelock py3-six py3-distlib py3-appdirs py3-virtualenv
do
	apk add --virtual ${pip}
done
echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> OK"
echo

echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> Uninstalling unnecessary packages"
docker-install -d -c ${PKG_DEV}
echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> OK"
echo

